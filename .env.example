# ThreatGuard Environment Configuration Template
# Mode Selection (0 = Moto Emulator, 1 = Real AWS)
CG_LIVE_AWS=0
CG_DRY_RUN=0
CG_ALLOW_LIVE_SETUP=0

# Security & Data Protection
CG_MASK_IDS=1
# Optional static API key; if left blank, a secure random key is auto-generated on startup
CG_API_KEY=

# AWS Resource Configuration
CG_BUCKET=student-records-demo
# AWS_PROFILE=threatguard-sandbox   (uncomment only for the live AWS run)

# Telegram Alerting & Approvals
TG_TOKEN=
TG_CHAT_ID=
# Comma-separated list of additional authorized Telegram user IDs
TG_ALLOWED_USERS=

# Dashboard / Evaluation
CG_BASELINE=1
CG_VIDEO_URL=
